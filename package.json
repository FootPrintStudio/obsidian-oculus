{
	"name": "obsidian-media-gallery",
	"version": "1.2.0",
	"description": "Local and remote media galleries for Obsidian with grid, carousel, masonry, URL video, and hosted platforms.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild src/views/deferredMedia.ts --bundle --platform=node --format=esm --outfile=.test-build/deferredMedia.mjs && node --test test/deferredMedia.test.mjs"
	},
	"keywords": ["obsidian", "plugin", "gallery", "media"],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"typescript": "^5.8.3"
	}
}
